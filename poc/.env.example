# 复制成 .env 后填写。.env 在 .gitignore 里，不会入库——别把真实 key 提交上去。

# 模型：任何 OpenAI 兼容、且支持 function calling 的服务都行
# 默认是 DeepSeek，换供应商只改这三行，接入方式见 docs/07-deployment.md 第 5 节
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 单个任务的上限：超了就停下来报阻塞，不会无限重试烧钱
MAX_USD=0.50
MAX_TURNS=40

# 本地 Gitea：这两个值由 infra/setup.sh 自动写入，不用手填
GITEA_URL=http://localhost:3000
GITEA_USER=codeless
GITEA_TOKEN=

# 部署好的站点入口，改端口时要和 infra/docker-compose.yml 里保持一致
PAGES_URL=http://localhost:8081
